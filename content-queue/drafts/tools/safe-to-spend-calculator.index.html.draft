</header>

<main class="page-main">
  <div class="container">
    <section class="page-hero reveal">
      <div class="page-hero-label">Free Tool</div>
      <h1>Safe to Spend Calculator</h1>
      <p>Your safe to spend amount is your balance minus bills due before payday minus savings you move first. This calculator shows you how much you can spend each day before payday, or if you're short, how much you're short by. Nothing is sent anywhere: the math runs in your browser.</p>
    </section>

    <section class="block reveal">
      <div class="block-title">Your situation</div>
      <h2>What you have and what is coming</h2>
      <p class="calc-note">Enter your current balance, bills due before payday, savings you move first, and days until payday to calculate your safe to spend amount.</p>
      <form id="calcForm" class="calc-form" novalidate>
        <label for="balance">Current balance ($)
          <input id="balance" name="balance" type="number" min="0" max="1000000" step="1" value="1850" inputmode="decimal">
        </label>
        <label for="daysUntilPayday">Days until payday
          <input id="daysUntilPayday" name="daysUntilPayday" type="number" min="1" max="31" step="1" value="7" inputmode="numeric">
        </label>
        <label for="savings">Savings you move first ($)
          <input id="savings" name="savings" type="number" min="0" max="1000000" step="1" value="100" inputmode="decimal">
        </label>
        <div class="bill-row">
          <label for="bill1">Bill 1 ($)
            <input id="bill1" name="bill1" type="number" min="0" max="100000" step="1" value="950" inputmode="decimal">
          </label>
          <label for="bill1Label">Label
            <input id="bill1Label" name="bill1Label" type="text" placeholder="e.g., Rent" value="Rent">
          </label>
        </div>
        <div class="bill-row">
          <label for="bill2">Bill 2 ($)
            <input id="bill2" name="bill2" type="number" min="0" max="100000" step="1" value="120" inputmode="decimal">
          </label>
          <label for="bill2Label">Label
            <input id="bill2Label" name="bill2Label" type="text" placeholder="e.g., Car Payment" value="Utilities">
          </label>
        </div>
        <div class="bill-row">
          <label for="bill3">Bill 3 ($)
            <input id="bill3" name="bill3" type="number" min="0" max="100000" step="1" value="250" inputmode="decimal">
          </label>
          <label for="bill3Label">Label
            <input id="bill3Label" name="bill3Label" type="text" placeholder="e.g., Groceries" value="Car payment">
          </label>
        </div>
        <div class="bill-row">
          <label for="bill4">Bill 4 ($)
            <input id="bill4" name="bill4" type="number" min="0" max="100000" step="1" value="300" inputmode="decimal">
          </label>
          <label for="bill4Label">Label
            <input id="bill4Label" name="bill4Label" type="text" placeholder="e.g., Utilities" value="Groceries">
          </label>
        </div>
        <div class="bill-row">
          <label for="bill5">Bill 5 ($)
            <input id="bill5" name="bill5" type="number" min="0" max="100000" step="1" value="80" inputmode="decimal">
          </label>
          <label for="bill5Label">Label
            <input id="bill5Label" name="bill5Label" type="text" placeholder="e.g., Phone Bill" value="Insurance">
          </label>
        </div>
        <div class="bill-row">
          <label for="bill6">Bill 6 ($)
            <input id="bill6" name="bill6" type="number" min="0" max="100000" step="1" value="0" inputmode="decimal">
          </label>
          <label for="bill6Label">Label
            <input id="bill6Label" name="bill6Label" type="text" placeholder="e.g., Other" value="">
          </label>
        </div>
        <p class="calc-note" id="calcError" role="alert" hidden></p>
      </form>
    </section>

    <section class="block reveal">
      <div class="block-title">The number</div>
      <h2>Your safe to spend amount</h2>
      <div class="calc-grid">
        <div class="calc-stat"><div class="calc-stat-label">Safe to spend</div><div class="calc-stat-value" id="safeToSpend">&mdash;</div></div>
        <div class="calc-stat"><div class="calc-stat-label">Per day</div><div class="calc-stat-value" id="perDay">&mdash;</div></div>
      </div>
      <p id="shortfallLine" class="calc-note"></p>
      <!-- RESULT_CTA: an App Store CTA at the moment of value (2026-09-30). Remove this block to undo. -->
      <p class="calc-note result-cta-reason">This calculation is based on your balance, bills due before payday, and savings you move first. Forgenta tracks your spending and balances to keep this calculation accurate.</p>
      <div class="cta-row result-cta">
        <a href="https://apps.apple.com/us/app/forgenta-track-build-wealth/id6762540239?ct=tool_safe-to-spend-calculator" target="_blank" rel="noopener" class="btn btn-gold">Get Forgenta on the App Store ↗</a>
        <a href="https://play.google.com/store/apps/details?id=com.treforged.forged&amp;referrer=utm_source%3Dtreforged%26utm_medium%3Dtool%26utm_campaign%3Dsafe-to-spend-calculator" target="_blank" rel="noopener" class="btn btn-ghost">Google Play ↗</a>
      </div>
      <p class="calc-note">Safe to spend = balance - bills due before payday - savings moved first. If the result is negative, it shows how much you're short by.</p>
    </section>

    <section class="block reveal">
      <div class="block-title">Next step</div>
      <h2>Track your spending and balances</h2>
      <p>Knowing your safe to spend amount is the first step. <a href="https://getforgenta.com/?utm_source=blog&amp;utm_medium=tool&amp;utm_campaign=safe-to-spend-calculator" target="_blank" rel="noopener">Forgenta</a> tracks your spending and balances to keep this calculation accurate and shows you how your situation changes over time.</p>
      <p class="calc-note">Related reading: <a href="/blog/how-to-budget/">how to budget</a> · <a href="/blog/how-to-save-money/">how to save money</a> · <a href="/tools/credit-card-interest-calculator/">credit card interest calculator</a> · <a href="/tools/debt-payoff-calculator/">debt payoff calculator</a></p>
    </section>
  </div>
</main>

<script type="module">
  import { safeToSpend, perDay, shortfall } from './calc.js';

  var $ = function (id) { return document.getElementById(id); };
  var money0 = function (n) { return (n < 0 ? '-$' : '$') + Math.abs(Math.round(n)).toLocaleString('en-US'); };
  var money2 = function (n) { return '$' + n.toFixed(2); };
  var DASH = '—';
  var BILL_FIELDS = ['bill1', 'bill2', 'bill3', 'bill4', 'bill5', 'bill6'];
  var VALUE_IDS = ['safeToSpend', 'perDay'];
  var SUB_IDS = ['shortfallLine'];

  function readField(id) {
    var raw = $(id).value.trim();
    return raw === '' ? 0 : parseFloat(raw);
  }

  function render() {
    var balance = readField('balance');
    var daysUntilPayday = readField('daysUntilPayday');
    var savings = readField('savings');

    var bills = {};
    BILL_FIELDS.forEach(function (f) {
      bills[f] = readField(f);
    });

    var err = $('calcError');
    // Validate inputs
    if (!isFinite(balance) || balance < 0 || balance > 1000000) {
      err.textContent = 'Enter a balance between $0 and $1,000,000.';
      err.hidden = false;
      VALUE_IDS.forEach(function (i) { $(i).textContent = DASH; });
      SUB_IDS.forEach(function (i) { $(i).textContent = ''; });
      return;
    }
    if (!isFinite(daysUntilPayday) || daysUntilPayday < 1 || daysUntilPayday > 31) {
      err.textContent = 'Enter days until payday between 1 and 31.';
      err.hidden = false;
      VALUE_IDS.forEach(function (i) { $(i).textContent = DASH; });
      SUB_IDS.forEach(function (i) { $(i).textContent = ''; });
      return;
    }
    if (!isFinite(savings) || savings < 0 || savings > 1000000) {
      err.textContent = 'Enter savings between $0 and $1,000,000.';
      err.hidden = false;
      VALUE_IDS.forEach(function (i) { $(i).textContent = DASH; });
      SUB_IDS.forEach(function (i) { $(i).textContent = ''; });
      return;
    }
    var badBill = false;
    BILL_FIELDS.forEach(function (f) {
      if (!isFinite(bills[f]) || bills[f] < 0 || bills[f] > 100000) {
        badBill = true;
      }
    });
    if (badBill) {
      err.textContent = 'Enter bill amounts between $0 and $100,000.';
      err.hidden = false;
      VALUE_IDS.forEach(function (i) { $(i).textContent = DASH; });
      SUB_IDS.forEach(function (i) { $(i).textContent = ''; });
      return;
    }
    err.hidden = true;

    var safe = safeToSpend(balance, bills, savings);
    $('safeToSpend').textContent = money0(safe);

    var daily = perDay(safe, daysUntilPayday);
    $('perDay').textContent = daily > 0 ? money2(daily) : DASH;

    var short = shortfall(safe);
    if (short > 0) {
      $('shortfallLine').textContent = 'You are short by ' + money0(short) + '.';
    } else {
      $('shortfallLine').textContent = '';
    }
  }

  $('calcForm').addEventListener('input', render);
  $('calcForm').addEventListener('submit', function (e) { e.preventDefault(); });
  render();
</script>

